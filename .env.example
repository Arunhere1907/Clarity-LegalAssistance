# GEMINI_API_KEY: Required for Gemini AI API calls.
# Obtain your free API key at: https://aistudio.google.com/apikey
# For local development, copy this file to .env and insert your key.
# For Vercel deployment, add this variable in Project Settings > Environment Variables.
GEMINI_API_KEY="your_gemini_api_key_here"

# (Optional) Preferred Gemini Model (defaults to gemini-2.5-flash with automatic fallback)
GEMINI_MODEL="gemini-2.5-flash"

# (Optional) Local development port
PORT=3000
